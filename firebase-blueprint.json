{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FalconElectricsStoreSchema",
  "description": "Firestore schema for Falcon Electrics product catalog, branding, and real-time settings",
  "entities": {
    "products": {
      "title": "Product",
      "description": "Electrical switchgear and modular accessories products",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique product ID" },
        "name": { "type": "string", "description": "Product display name" },
        "category": { "type": "string", "description": "Category slug/ID" },
        "price": { "type": "number", "description": "Price in INR" },
        "rating": { "type": "number", "description": "Product rating" },
        "reviewsCount": { "type": "number", "description": "Total reviews count" },
        "specs": {
          "type": "object",
          "properties": {
            "current": { "type": "string" },
            "voltage": { "type": "string" },
            "control": { "type": "string" },
            "warranty": { "type": "string" },
            "gang": { "type": "string" },
            "material": { "type": "string" }
          }
        },
        "description": { "type": "string", "description": "Detailed description" },
        "highlights": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of key safety/technical highlights"
        },
        "image": { "type": "string", "description": "Image identifier or image URL" },
        "isNew": { "type": "boolean", "description": "Whether product has NEW badge" },
        "isPopular": { "type": "boolean", "description": "Whether product has POPULAR badge" },
        "createdAt": { "type": "string", "description": "Timestamp ISO" },
        "updatedAt": { "type": "string", "description": "Timestamp ISO" }
      },
      "required": ["name", "category", "price"]
    },
    "categories": {
      "title": "Category",
      "description": "Product categories in the catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Category identifier" },
        "title": { "type": "string", "description": "Category title" },
        "subtitle": { "type": "string", "description": "Category subtitle" },
        "description": { "type": "string", "description": "Category description" },
        "badge": { "type": "string", "description": "Category badge text" },
        "icon": { "type": "string", "description": "Icon name" },
        "iconName": { "type": "string", "description": "Icon name alias" },
        "image": { "type": "string", "description": "Visual image key or URL" },
        "bgColor": { "type": "string", "description": "Tailwind background class" }
      },
      "required": ["title"]
    },
    "catalogue_pages": {
      "title": "CataloguePage",
      "description": "Product catalogue brochure pages and uploaded photos",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique page slot ID" },
        "pageNumber": { "type": "number", "description": "Page number order" },
        "title": { "type": "string", "description": "Page title" },
        "subtitle": { "type": "string", "description": "Page subtitle" },
        "description": { "type": "string", "description": "Page description" },
        "categoryTag": { "type": "string", "description": "Category tag label" },
        "imageUrl": { "type": "string", "description": "Uploaded image URL or Base64" },
        "image": { "type": "string", "description": "Image alias or URL" },
        "updatedAt": { "type": "string", "description": "Timestamp ISO" }
      },
      "required": ["id", "pageNumber"]
    },
    "store_settings": {
      "title": "StoreSettings",
      "description": "Global store settings, logos, branding, and contact details",
      "type": "object",
      "properties": {
        "companyDetails": { "type": "object" },
        "heroContent": { "type": "object" },
        "logoImageUrl": { "type": "string" },
        "whyChooseUs": { "type": "array", "items": { "type": "object" } },
        "updatedAt": { "type": "string" }
      }
    },
    "admin_auth": {
      "title": "AdminAuth",
      "description": "Admin authentication credentials",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "password": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "password"]
    }
  },
  "firestoreRules": "firestore.rules"
}
