rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== STORE BRANDING & SETTINGS =====
    // Company details, hero section, logos, why-choose-us cards
    match /store_settings/{settingId} {
      allow read, write: if true;
    }

    // ===== PRODUCTS CATALOG =====
    // Full real-time synchronization for products
    match /products/{productId} {
      allow read, write: if true;
    }

    // ===== PRODUCT CATEGORIES =====
    // Category list and sort order
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // ===== CATALOGUE PAGES =====
    // Dedicated collection for catalogue photos and pages
    match /catalogue_pages/{pageId} {
      allow read, write: if true;
    }

    // ===== QUOTE & INQUIRY REQUESTS =====
    // Validated public create, full access for admin management
    match /quotes/{quoteId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.phone is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.phone.size() >= 10;
      allow read, update, delete: if true;
    }

    // ===== DEPRECATED / SENSITIVE COLLECTIONS =====
    // Blocked from public read/write
    match /admin_auth/{authId} {
      allow read, write: if false;
    }

    // ===== DEFAULT DENY =====
    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
